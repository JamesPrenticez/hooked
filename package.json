{
	"name": "hooked",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n client,server -c blue,green \"pnpm:dev:client\" \"pnpm:dev:server\"",
		"dev:client": "vite",
		"dev:server": "nodemon -w server/src -e ts --exec \"node --disable-warning=ExperimentalWarning --env-file-if-exists=.env\" server/src/index.ts",
		"test:server": "node --disable-warning=ExperimentalWarning --test \"server/src/**/*.test.ts\"",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"format": "prettier --write .",
		"test": "vitest",
		"e2e:test": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"prepare": "husky"
	},
	"dependencies": {
		"@pixi/react": "^8.0.5",
		"howler": "^2.2.4",
		"normalize.css": "^8.0.1",
		"pixi.js": "^8.20.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"styled-components": "^6.5.3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@storybook/addon-a11y": "^10.5.4",
		"@storybook/addon-docs": "^10.5.4",
		"@storybook/react-vite": "^10.5.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.6",
		"@types/howler": "^2.2.13",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"@vitest/coverage-v8": "^4.1.11",
		"concurrently": "^10.0.5",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.5",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"globals": "^17.11.0",
		"happy-dom": "^20.11.15",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.6",
		"storybook": "^10.5.4",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vite-plugin-svgr": "^5.2.0",
		"vitest": "^4.1.11"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,jsonc,css,md,yml,yaml,html}": [
			"prettier --write"
		]
	}
}
