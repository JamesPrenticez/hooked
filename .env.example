# Client (Vite) — must be prefixed VITE_
VITE_API_BASE_URL=http://127.0.0.1:4201
# Expose the /api/debug/* dev controls in the client. Leave unset for production.
VITE_DEBUG=true

# Mock Game Server
SERVER_PORT=4201
OPERATOR_ID=dev-operator
OPERATOR_SECRET=dev-operator-secret
DEV_CURRENCY=USD
DEV_BALANCE=1000.00
DEV_MIN_BET=0.10
DEV_MAX_BET=500.00
# Production only: the deployed client's origin, no trailing slash. Dev allows any origin.
# CORS_ORIGIN=https://hooked.onrender.com
