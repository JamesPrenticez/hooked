{
	"compilerOptions": {
		"target": "es2022",
		"useDefineForClassFields": true,
		"lib": ["es2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		// One alias per src/ bucket, named after the folder — "@stores/x" is
		// src/stores/x. Add a bucket's alias here only once something actually
		// imports across into it. "@hooked-ui" is the vendored component
		// library, addressed like the npm package it replaced.
		//
		// "types/" is aliased as "@type", not "@types" — tsc special-cases any
		// specifier starting with "@types/" as a DefinitelyTyped declaration
		// package and refuses to import it as a normal module (TS6137).
		//
		// Keep in sync with "resolve.alias" in vite.config.js.
		"paths": {
			"@api": ["./src/api/index.ts"],
			"@api/*": ["./src/api/*"],
			"@assets/*": ["./src/assets/*"],
			"@components/*": ["./src/components/*"],
			"@constants/*": ["./src/constants/*"],
			"@hooks/*": ["./src/hooks/*"],
			"@stores/*": ["./src/stores/*"],
			"@type/*": ["./src/types/*"],
			"@hooked-ui": ["./src/hooked-ui/index.ts"]
		}
	},
	"include": ["src"]
}
